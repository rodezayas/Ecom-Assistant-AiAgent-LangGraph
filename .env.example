# Copy to .env and fill values — never commit .env with real secrets
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_PUBLIC_URL=https://your-public-url
TELEGRAM_WEBHOOK_SECRET_TOKEN= # generate: openssl rand -hex 32
FRONTEND_BASE_URL=https://alta-norma-fashion.lovable.app
ADMIN_API_KEY= # generate: openssl rand -hex 32

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE_PATH=./data/vectorstore
KNOWLEDGE_BASE_DIR=./data/knowledge

# Phoenix Cloud — record content disabled by default (PII)
PHOENIX_ENABLED=false
PHOENIX_API_KEY=
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/v1/traces
PHOENIX_PROJECT_NAME=langgraph-ecom-assistant
PHOENIX_RECORD_CONTENT=false

# Supabase Golden Dataset
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PROJECT_ID=<ref>
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # server-side only, short-lived, never expose to frontend

ENVIRONMENT=dev
